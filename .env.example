# OpenAI API Key (required for LLM-powered agent decisions)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model to use (default: gpt-4o-mini for cost efficiency, use gpt-4o for best results)
LLM_MODEL=gpt-4o-mini

# Database URL (default: SQLite local file)
DATABASE_URL=sqlite:///./purchasing.db
